# Install on the OpenClaw host (not in the public status web container).
# Site-local drop-in supplies the exact tailnet peer/address and protected paths.
[Unit]
Description=Dash status authenticated incident inbox and serialized OpenClaw worker
After=network-online.target tailscaled.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=1000
Group=1000
WorkingDirectory=/var/lib/dash-incident-broker
ExecStart=/usr/bin/false
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/dash-incident-broker
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
