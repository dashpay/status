[Unit]
Description=Dash mainnet limited-signal observer
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/dash-mainnet-observer/env
ExecStart=/usr/bin/python3 /opt/dash-mainnet-observer/mainnet-observer.py
TimeoutStartSec=150
StateDirectory=dash-mainnet-observer
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
