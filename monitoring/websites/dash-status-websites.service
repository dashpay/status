[Unit]
Description=Dash public website performance probes (status-host vantage point)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
ExecStart=/usr/bin/python3 /opt/dash-status/websites/probe.py --output /srv/dash-status/data/websites/report.json
TimeoutStartSec=140
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/srv/dash-status/data/websites
MemoryMax=192M
CPUWeight=10
LimitFSIZE=16M
UMask=0022
