# /etc/sudoers.d/dashmon
# Allow dashmon user to run read-only monitoring commands only.
# Both rule sets present on all nodes; unused rules are harmless.

# HP masternodes: Core RPC via dashmate. These replace `dashmate status`,
# which was removed from the hot path because it probes mnowatch.org.
dashmon ALL=(dashmate) NOPASSWD: /usr/bin/dashmate core cli getblockchaininfo
dashmon ALL=(dashmate) NOPASSWD: /usr/bin/dashmate core cli getnetworkinfo
dashmon ALL=(dashmate) NOPASSWD: /usr/bin/dashmate core cli masternode status

# Transitional: keep the old `dashmate status` rule until every HP host has
# been re-deployed with the updated dashmon-check.sh. Safe to remove once
# the rollout is complete (the new script does not invoke it).
dashmon ALL=(dashmate) NOPASSWD: /usr/bin/dashmate status

# Regular masternodes: dash-cli commands as ubuntu user
dashmon ALL=(ubuntu) NOPASSWD: /usr/local/bin/dash-cli getblockchaininfo
dashmon ALL=(ubuntu) NOPASSWD: /usr/local/bin/dash-cli masternode status
